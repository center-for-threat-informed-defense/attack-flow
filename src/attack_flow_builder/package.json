        "@tensorflow/tfjs": "^4.18.0",
        "@zip.js/zip.js": "^2.7.31",
        "ai": "^7.0.70",
        "d3": "^7.9.0",
        "flexsearch": "^0.8.167",
        "html-to-image": "^1.11.13",
        "luxon": "3.5",
        "pdfjs-dist": "4.10.38",
        "pinia": "^2.3.0",
