# --- API runtime ---
APP_NAME=attack-flow-api
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
API_BIND_PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ENABLED=false
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# --- API persistent storage ---
DATA_DIR=/var/lib/attack-flow/data
SQLITE_PATH=/var/lib/attack-flow/data/attack-flow.db
UPLOAD_DIR=/var/lib/attack-flow/data/uploads
ARTIFACT_DIR=/var/lib/attack-flow/data/artifacts

# --- API storage hardening ---
FILE_STORAGE_STRICT_MODE=true
FILE_STORAGE_MAX_BYTES=10485760

# --- API provider config ---
PROVIDERS_CONFIG_PATH=/app/config/providers.yml
# Runtime provider overrides allow request-supplied provider settings for validation/jobs.
# Runtime API keys and secret-bearing header values are not persisted.
ALLOW_RUNTIME_PROVIDER_OVERRIDE=false
ALLOW_RUNTIME_PROVIDER_TYPES=openai,openai_compatible,azure_openai
ALLOW_RUNTIME_PROVIDER_EXTRA_HEADERS=false
RUNTIME_PROVIDER_TIMEOUT_SECONDS=180

# --- API provider credentials ---
# Set only the variables referenced by config/providers.yml.
OPENAI_API_KEY=
COMPATIBLE_PROVIDER_API_KEY=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LITELLM_LOCAL_MODEL_COST_MAP=true

# --- Corporate proxy / custom CA ---
# Place corporate root CA .crt files into ./certs; the API container imports them at startup.

# --- UI runtime/build ---
UI_BIND_PORT=8080
AFB_BASE_URL=/
# Default for separate-origin/local API deployment:
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Optional override used by bundled proxy stack (same-origin path):
VITE_API_BASE_URL_PROXY=/api/v1

# --- Optional bundled proxy ---
PROXY_BIND_PORT=8080
